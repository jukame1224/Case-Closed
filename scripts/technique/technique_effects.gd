const DETECTED_FAKE_EVIDENCE_COLLAPSE_DELTA := -5.0
const SILENT_VALID_COMBINATION_COLLAPSE_DELTA := 45.0

static func get_collapse_base_delta(technique_type: TechniqueExecutor.TechniqueType) -> float:
	match technique_type:
		TechniqueExecutor.TechniqueType.INCONSISTENCY_POINT:
			return INCONSISTENCY_POINT_COLLAPSE_DELTA
		TechniqueExecutor.TechniqueType.COGNITIVE_LOAD:
			return COGNITIVE_LOAD_COLLAPSE_DELTA
		TechniqueExecutor.TechniqueType.MAXIMIZATION:
			return MAXIMIZATION_COLLAPSE_DELTA
		TechniqueExecutor.TechniqueType.FALSE_EVIDENCE:
			return FALSE_EVIDENCE_COLLAPSE_DELTA
		TechniqueExecutor.TechniqueType.THIRD_PARTY_MENTION:
			return THIRD_PARTY_MENTION_COLLAPSE_DELTA
		TechniqueExecutor.TechniqueType.HIGH_PRESSURE:
			return HIGH_PRESSURE_COLLAPSE_DELTA
	return 0.0

static func get_applied_delta(base_delta: float, defense_stat: int) -> float:
	return base_delta * (1.0 - float(defense_stat) / 200.0)
