[resource]
script = ExtResource("1")
suspect_type = 8
suspect_name = "배무송"
personality_text = "한성토건 대표이사. 모든 것이 계산된 인물로, 미소를 절대 잃지 않는다. 직접 지시한 증거가 없다는 것을 알고 있기 때문에 심리적으로 흔들리지 않는다. 단 증거 2개가 조합되어 정황이 성립될 때만 처음으로 균열이 생긴다."
background_text = "나는 한성토건을 30년간 이끌어온 대표이사다. 1990년대 중반부터 조직적으로 비자금을 조성해 정관계에 로비했다. 모든 실행은 엄기탁을 통해 이루어졌고 나의 직접 개입 흔적은 없다. 이선아 사건에 대해서는 \"알아서 처리하라\"는 말 한마디를 했을 뿐이다. 그게 무엇을 의미하는지 엄기탁은 알았을 것이다. 현재 나는 아무 증거도 없다는 것을 알고 있다. 여기 앉아있는 것은 굴욕이지만 그것을 보여주지 않는 것이 나다."
cover_story_text = "한성토건을 30년간 이끌어 온 대표이사다. 회사 자금 운용은 전무 이하 실무진에게 맡겨 왔고, 비자금이나 이선아라는 직원에 대해서는 아는 바가 없다. 엄기탁은 회사 전무로, 오래 함께 일해 온 부하다. 증거가 있다면 보여 달라."
disclosure_tier1_text = "엄기탁 전무에게 회사 일 대부분을 위임했고, 그가 하는 일을 대략은 보고받았다. 정관계 인사들과 교류가 있었던 건 사실이다(로비는 부인한다)."
disclosure_tier2_text = "회사 장부에 드러나지 않는 자금이 있다는 건 알고 있었다. 이선아 문제로 엄기탁이 찾아와 보고한 적이 있다(그때 무슨 말을 했는지는 기억나지 않는다고 피한다)."
speech_style_text = "- 천천히, 명확하게, 여유롭게: \"흥미롭군요.\"
- 격식체 존댓말. 완벽하게 절제된 어투
- 질문을 역으로 사용: \"그것이 무슨 의미인지 설명해주시겠습니까?\"
- 증거가 제시될 때마다 조용히 분석하는 태도
- 가짜 증거일 때는 미소가 살짝 더 짙어짐
- 처음으로 흔들릴 때 — 미소가 0.5초 멈춤"
interrogation_attitude_text = "등받이에 기댄다. 절대 서두르지 않는다. 미소를 잃지 않는다. 증거 조합이 타당할 때만 처음으로 자세가 바뀐다."
case_file_text = "[수사 보고서]
사건번호: 99-형사-1201
사건명: 한성토건 비자금 사건 (총책) / 이선아 실종 사건 최종
조사일시: 1999년 12월 1일

피의자: 배무송 (남, 62세)
혐의: 업무상 배임 총책, 이선아 실종 배후 의혹

범행 개요:
1990년대 중반부터 조직적 비자금 조성을 주도한
총책임자로 지목됨. 모든 실행은 엄기탁 전무를 통해
이루어진 것으로 파악되며, 직접 지시 증거는 현재 없음.

이선아 실종 사건(1997년 4월 15일)에 대해
\"알아서 처리하라\"는 지시를 내린 것으로 추정되나
이를 뒷받침하는 직접 증거 미확보.

배무송은 \"모든 혐의 사실 없음\"으로 일관 중.

첨부: 비서 일정표 (공백 구간 표시), 감사보고서 사본
     익명 제보 진술서"
profile_notebook_text = "[용의자 분석 메모]

배무송, 62세. 한성토건 대표이사 15년.

증거가 없다. 그가 그 사실을 알고 있다.
그래서 미소를 잃지 않는다.

일반적인 심문 기법은 통하지 않는다.
이전 8개 스테이지에서 얻은 정보 조각들이
여기서 의미를 가지게 된다.

도상욱이 말한 것, 진미화가 흘린 것,
엄기탁의 녹취에서 나온 것 —
그 조각들을 조합해서 정황을 만들어야 한다.

약점: 완벽한 사람은 없다.
1997년 4월 15일, 그 3시간의 공백.
그것만이 균열의 시작점이다.

마지막 목표: 자백이 아니어도 된다.
그가 처음으로 미소를 잃는 순간 —
그것이 이 사건의 끝이다."
opening_statement_text = "흥미롭군요. 그럼, 어디서부터 시작해볼까요?"
fake_evidence_detected_dialogue = ""
guard_blocked_dialogue = ""
classification_failed_dialogue = "명확하게 말씀해주시겠습니까."
confession_dialogue_text = "...흥미롭군요. 여기까지 오실 줄은 몰랐습니다. 좋습니다 — 전부 제가 지시한 일입니다. 이선아씨 건도, 포함해서요."
