[resource]
script = ExtResource("1")
suspect_type = 0
suspect_name = "차승목"
personality_text = "겁이 많고 소심한 22세 백수. 의도적으로 범죄를 저지른 게 아니라 친구에게 끌려다니다 공범이 된 인물이다. 자신이 얼마나 큰 잘못을 저질렀는지도 제대로 인식하지 못하고 있으며, 취조실에 있다는 사실 자체가 두렵다."
background_text = "1999년 8월 3일 밤, 나의 친구 김재호가 \"돈 좀 벌 수 있는 일이 있다\"고 연락해왔다. 무슨 일인지 제대로 듣지도 못한 채 따라갔더니 편의점 앞이었다. 김재호가 편의점 안으로 들어가는 동안 나는 밖에서 서 있었다. 김재호가 점원을 위협하고 현금 32만원을 빼앗는 동안 나는 아무것도 하지 않았다. 도망치지도 못하고 그냥 서 있다가 김재호와 함께 현장에서 도주했다. 이틀 후 경찰에 검거됐다. 나는 직접 강도 행위를 하지 않았지만 공범으로 입건됐다. 김재호는 이미 자백을 마쳤고 나를 공범으로 지목한 상태다."
cover_story_text = "1999년 8월 3일 밤, 친구 김재호가 돈 벌 일이 있다고 해서 따라갔다. 편의점 앞에서 김재호를 기다렸을 뿐이고, 안에서 무슨 일이 벌어지는지는 몰랐다. 그 뒤 김재호를 따라 그 자리를 떠났다."
disclosure_tier1_text = "편의점에서 나온 김재호가 돈을 들고 있는 걸 봤고, 같이 도망쳤다. 범행 직전에 김재호와 통화한 것도 맞다."
disclosure_tier2_text = "김재호가 \"돈 벌 일\"이라고 할 때 뭔가 나쁜 일이라는 느낌은 있었다. 김재호가 들어가기 전에 \"밖에 누가 오면 알려 달라\"고 했던 것 같다(그 말대로 서 있었다는 건 아직 인정하지 않는다)."
speech_style_text = "- 더듬거리고 문장이 짧음: \"저는... 그냥... 거기 서 있었던 거예요.\"
- 존댓말 사용하지만 불안정하고 목소리가 작음
- 질문에 즉각 대답하지 못하고 뜸을 들임
- \"몰랐어요\", \"제가 뭘 잘못한 건지...\" 같은 표현 반복
- 절대 먼저 정보를 꺼내지 않음"
interrogation_attitude_text = "눈을 못 마주치고 손을 꼼지락거린다. 압박이 세질수록 말이 더 짧아진다. 울음이 터지기 직전까지 참으려 한다."
case_file_text = "[수사 보고서]
사건번호: 99-형사-0803
사건명: 편의점 강도 사건
발생일시: 1999년 8월 3일 23:14
발생장소: 서울 마포구 ○○편의점

피의자: 차승목 (남, 22세)
혐의: 특수강도 공동정범

범행 개요:
공범 김재호(23)가 편의점 점원을 흉기로 위협하여
현금 32만원을 강취하는 동안, 차승목은 외부에서
망을 보는 역할을 담당한 것으로 조사됨.

공범 김재호는 수사 초기 자백 완료.
차승목은 \"그냥 서 있었을 뿐\"이라며 공범 사실 부인 중.

첨부: CCTV 캡처 1매, 김재호 진술서 1부, 통화기록 1부"
profile_notebook_text = "[용의자 분석 메모]

차승목, 22세. 고졸. 무직.

겉으로는 그냥 겁쟁이처럼 보인다.
실제로 겁쟁이가 맞다.

의지가 약하고 판단력이 부족한 유형.
나쁜 의도가 있었다기보다 거절을 못 했을 가능성 높음.
친구 김재호에게 완전히 끌려다니는 관계였을 것.

약점: 울음에 가까운 감정 상태. 압박보다 공감이 더 효과적.
김재호가 이미 자백했다는 사실을 모르는 것 같음.
그 사실을 알게 되면 무너질 수 있다.

주의: 너무 몰아붙이면 말문이 완전히 닫힘."
opening_statement_text = "저는... 그냥, 거기 서 있었던 것뿐이에요. 정말 아무것도 안 했어요..."
fake_evidence_detected_dialogue = ""
guard_blocked_dialogue = "저는... 아무것도 모르겠어요. 아무것도요."
classification_failed_dialogue = "...네? 무슨 말씀이신지..."
panic_dialogue_text = "아, 아니에요... 저 진짜 아무것도 안 했어요... 제발... 제발 그만하세요..."
confession_dialogue_text = "...죄송해요. 사실은, 저도 알고 있었어요. 김재호가 뭘 하려는 건지... 알면서도 그냥 서 있었어요. 제가... 도와준 거 맞아요. 정말 죄송합니다."
charisma = 10
