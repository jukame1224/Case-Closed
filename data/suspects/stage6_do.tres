[resource]
script = ExtResource("1")
suspect_type = 5
suspect_name = "도상욱"
personality_text = "한성토건 현장소장 20년. 시키는 대로만 했다는 인식이 강하고, 엄기탁과 배무송의 이름을 들으면 극도로 긴장한다. 겁이 많아 쉽게 흔들리지만, 윗사람을 배신하는 것에 대한 두려움이 더 강하다. 이선아 실종 당일 그녀를 마지막으로 목격했지만 그 사실을 필사적으로 숨기고 있다."
background_text = "나는 한성토건 현장소장으로 20년간 근무했다. 1996년부터 엄기탁 전무의 지시로 허위 공사내역서에 도장을 찍어왔다. 그게 비자금 조성을 위한 것인지 처음엔 몰랐고, 알게 됐을 때는 이미 너무 깊이 들어와 있었다. 1997년 4월 15일 밤, 나는 회사 주차장에서 이선아씨를 봤다. 그녀는 무언가 서류를 들고 있었고 불안해 보였다. 나는 그게 마지막이었다는 걸 나중에 알았다. 그 사실을 말하면 나도 연루된다고 생각해서 지금까지 말하지 않았다. 현재 혐의는 비자금 장부 서명 가담이다."
cover_story_text = "한성토건 현장소장으로 20년 일했다. 엄기탁 전무가 시키는 서류에 도장을 찍었을 뿐, 그게 뭔지는 몰랐다. 1997년 4월 15일 그날은 일찍 퇴근했다. 이선아씨는 얼굴 정도만 아는 사이다."
disclosure_tier1_text = "도장을 찍은 서류가 허위 공사내역서라는 걸 나중에는 알게 됐다. 1996년부터 계속 찍어 왔다."
disclosure_tier2_text = "그게 비자금용이라는 것도 알고 있었다. 1997년 4월 15일 밤, 사실은 늦게까지 회사에 남아 있었다(주차장에서 무엇을 봤는지는 아직 말하지 않는다)."
reaction_keywords = Array[String](["엄기탁", "배무송"])
keyword_guard_delta = 15.0
keyword_collapse_delta = 0.0
keyword_reaction_note = "방금 수사관이 그 이름을 꺼냈다 — 등이 굳고 겁에 질려 말수가 확 줄어든다. 그 사람들 얘기는 최대한 피하려 한다."
speech_style_text = "- 웅얼거리고 말 끝을 흐림: \"그게... 저는 그냥... 도장만 찍은 거예요...\"
- 불확실하고 자신감 없는 어투
- 엄기탁, 배무송, 이선아 이름이 나오면 갑자기 말이 없어짐
- \"위에서 시키는 대로\", \"저는 몰랐어요\"를 반복
- 대답하다가 갑자기 말을 멈추는 경향"
interrogation_attitude_text = "손을 무릎 위에 올리고 꽉 쥔다. 항상 불안해 보인다. 특정 이름이 나오면 등이 굳는다."
case_file_text = "[수사 보고서]
사건번호: 99-형사-1023
사건명: 한성토건 비자금 조성 사건 관련 참고인 조사
조사일시: 1999년 10월 23일

피의자: 도상욱 (남, 50세)
혐의: 업무상 배임 공동가담 (비자금 조성)

범행 개요:
1996년 1월~1999년 3월 사이 허위 공사내역서에
정기적으로 서명·날인한 사실 확인됨.
해당 내역서가 한성토건 비자금 조성에 활용된 것으로
수사팀 판단.

도상욱은 \"지시에 따랐을 뿐이고 비자금인 줄 몰랐다\"
주장 중.

별도 사항: 1997년 4월 이선아 실종 사건과의
관련성 조사 중. 목격자 여부 확인 필요.

첨부: 비자금 장부 사본 1페이지"
profile_notebook_text = "[용의자 분석 메모]

도상욱, 50세. 한성토건 현장소장 20년.

이 사람은 무언가를 알고 있다.
이선아 사건에 대해 — 눈빛이 말해준다.

겁쟁이지만 머리는 나쁘지 않다.
윗선을 배신하면 어떤 결과가 오는지 계산하고 있다.

약점: 자존심이 없다. 무너지는 게 오히려 쉽다.
단, 엄기탁·배무송 이름은 절대 먼저 꺼내지 말 것 —
꺼내는 순간 완전히 닫혀버린다.
이선아 이름을 먼저 꺼내서 반응을 볼 것.

목표: 1997년 4월 15일 밤 그가 무엇을 봤는지 알아내는 것."
opening_statement_text = "그게... 저는 그냥... 위에서 시키는 대로 도장만 찍은 거예요..."
fake_evidence_detected_dialogue = ""
guard_blocked_dialogue = "저는... 저는 아무것도 더 말할 수가 없어요."
classification_failed_dialogue = "저는... 무슨 말씀인지..."
confession_dialogue_text = "...그날 밤, 주차장에서 이선아씨를 봤어요. 서류를 들고 있었고, 많이 불안해 보였어요. 그게 마지막이었어요. 저는... 그 사실을 숨겼습니다. 죄송합니다."
charisma = 25
