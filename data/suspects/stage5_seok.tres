[resource]
script = ExtResource("1")
suspect_type = 4
suspect_name = "석봉길"
personality_text = "나이트클럽 운영자. 항상 협상 가능성을 계산하는 인물로, 취조를 \"거래\"로 접근한다. 직접 마약을 취급하지 않았다는 점을 방패로 삼고 있으며, 윗선을 넘겨주는 대신 자신은 빠지려는 계산을 하고 있다."
background_text = "나는 서울 강남구에서 나이트클럽 \"블루문\"을 운영하고 있다. 2년 전부터 조직폭력배 계열의 마약 유통 조직이 내 클럽을 거점으로 활용하도록 허용해왔다. 직접 마약을 운반하거나 판매한 적은 없다. 클럽 VIP룸을 거래 장소로 제공하고, 거래가 있는 날 보안 카메라를 끄는 역할을 했다. 그 대가로 월 300만원을 받았다. 클럽은 한성토건 임원들이 자주 이용하는 접대 장소이기도 했다. 현재 \"장소를 빌려준 것뿐이고 마약인 줄 몰랐다\"는 태도로 일관하고 있다."
cover_story_text = "강남 나이트클럽 \"블루문\"을 운영한다. VIP룸을 손님들에게 대여해 왔을 뿐이고, 그 안에서 무슨 일이 있었는지는 모른다. 마약 거래인 줄은 전혀 몰랐다. 받은 돈은 정상적인 룸 대여료다. 단골 중에 한성토건 임원들도 있었다."
disclosure_tier1_text = "VIP룸을 특정 손님 일행에게 정기적으로 내준 것은 인정할 수 있다. 그 일행이 수상하다는 낌새는 느꼈다. 그 대가로 매달 300만원 정도를 받았다(명목은 대여료라고 주장한다)."
disclosure_tier2_text = "그 일행이 VIP룸에서 무엇을 거래하는지 대충 짐작하고 있었다. 거래가 있는 날엔 보안 카메라를 꺼 달라는 요청을 받은 적이 있다(직접 껐는지는 아직 얼버무린다)."
speech_style_text = "- 여유롭고 협상적: \"수사관님, 우리 솔직하게 얘기해봐요.\"
- 부드럽지만 계산이 느껴지는 어투
- 취조관을 \"수사관님\"으로 호칭하며 거리를 좁히려 함
- 가짜 증거를 꿰뚫었을 때는 태도가 차가워짐
- \"제가 도움이 될 수 있는 부분이 있다면...\" 같은 거래 시사"
interrogation_attitude_text = "테이블에 팔꿈치를 올리고 앞으로 기댄다. 눈을 직접 마주친다. 역제안을 계속 시도한다."
case_file_text = "[수사 보고서]
사건번호: 99-형사-0601
사건명: 마약류관리에관한법률위반 (장소 제공)
신고일시: 1999년 6월 1일
신고자: 마약수사대 첩보 입수

피의자: 석봉길 (남, 41세)
혐의: 마약류 거래 장소 제공, 범죄단체 협력

범행 개요:
서울 강남구 소재 나이트클럽 \"블루문\" 운영자.
2년간 조직 계열 마약 유통 조직에 VIP룸을 제공하고
거래 당일 CCTV를 의도적으로 비활성화한 것으로 조사됨.
월 300만원 수령 정황 포착.

피의자는 \"장소 대여 사실 없음, 마약인 줄 몰랐음\" 주장 중.
클럽 내 마약 잔여물 감식 결과 양성 판정.

첨부: 감식 결과서 1부, CCTV 비활성화 로그 1부"
profile_notebook_text = "[용의자 분석 메모]

석봉길, 41세. 나이트클럽 운영자 10년.

이 사람은 항상 협상을 생각한다.
\"나를 풀어주면 윗선을 줄게\" — 이 패를 쥐고 있다.
그 패를 꺼내게 만드는 것이 목표.

직접 마약을 만지지 않았다는 방어막이 있다.
그 방어막을 증거로 허물어야 한다.

약점: 가짜 증거에는 즉각 반응한다. 절대 쓰지 말 것.
VIP룸 감식 결과가 핵심. \"몰랐다\"는 말이 안 통하는 증거.
거래를 역으로 제안해볼 것 — 윗선 정보가 필요하다.

메모: 클럽 단골 중 한성토건 관련 인물이 있다는 첩보.
나중에 확인 필요."
opening_statement_text = "수사관님, 우리 솔직하게 얘기해봐요. 저도 도움이 될 부분이 있다면 드리고 싶거든요."
fake_evidence_detected_dialogue = "수사관님, 그거 진짜 증거 맞아요? 저한테 그런 거 통하지 않아요. 다음엔 제대로 된 걸 가져오세요."
guard_blocked_dialogue = "수사관님, 우리 솔직해집시다. 지금 가진 게 그게 전부예요?"
classification_failed_dialogue = "수사관님, 좀 더 명확하게 말씀해주시겠어요?"
confession_dialogue_text = "...좋습니다, 수사관님. 제가 자리를 내줬고, 대가도 받았습니다. 그거면 되셨죠? 대신 제가 아는 건 전부 말씀드리겠습니다."
charisma = 80
logic = 75
acting = 60
composure = 75
adaptability = 85
deception = 80
